<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Отдел кадров</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Отдел кадров</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Employees" asp-action="Index">Работники</a>
                <a class="nav-link" asp-controller="Departments" asp-action="Index">Подразделения</a>
                <a class="nav-link" asp-controller="Positions" asp-action="Index">Должности</a>
                <a class="nav-link" asp-controller="Professions" asp-action="Index">Профессии</a>
                <a class="nav-link" asp-controller="Educations" asp-action="Index">Образование</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Отчёты</a>
            </div>
        </div>
    </nav>
    <div class="container pb-5">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>
</body>
</html>
